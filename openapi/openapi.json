  "info": {
    "title": "Financial API Platform",
    "description": "Secure financial APIs with OAuth 2.1-aligned authorization patterns, OpenID Connect, and consent management",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "OAuth 2.1 access token"
      },
      "idempotency": {
        "type": "apiKey",
        "in": "header",
        "name": "x-idempotency-key",
        "description": "Idempotency key for safe payment retries"
      },
      "correlation": {
        "type": "apiKey",
        "in": "header",
        "name": "x-correlation-id",
        "description": "End-to-end request correlation identifier"
      }
    },
    "schemas": {
      "CreatePaymentRequestDto": {
        "type": "object",
        "properties": {
          "sourceAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "amountMinor": {
            "type": "number",
            "minimum": 1,
            "example": 1250,
            "description": "Amount in minor units (e.g. cents)"
          },
          "currency": {
            "type": "string",
            "example": "USD",
            "enum": ["USD", "EUR", "GBP", "CAD", "AUD", "JPY"]
          },
          "creditorName": {
            "type": "string",
            "minLength": 1,
            "example": "Acme Utilities"
          },
          "creditorAccountRef": {
            "type": "string",
            "minLength": 1,
            "example": "GB29NWBK60161331926819"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "example": "Invoice 1042"
          }
        },
        "required": [
          "sourceAccountId",
          "amountMinor",
          "currency",
          "creditorName",
          "creditorAccountRef",
          "reference"
        ]
      },
      "AuthorizePaymentRequestDto": {
        "type": "object",
        "properties": {
          "actorUserId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["actorUserId"]
      },
      "SubmitPaymentRequestDto": {
        "type": "object",
        "properties": {
          "actorClientId": {
            "type": "string",
            "description": "Defaults to authenticated client"
          }
        }
      },
      "CancelPaymentRequestDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "CreateConsentRequestDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "requestedScopes": {
            "type": "string",
            "example": "accounts:read balances:read payments:write"
          },
          "purpose": {
            "type": "string",
            "minLength": 3,
            "example": "Personal finance aggregation"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "clientId",
          "institutionId",
          "requestedScopes",
          "purpose",
          "expiresAt"
        ]
      },
      "AuthorizeConsentRequestDto": {
        "type": "object",
        "properties": {
          "accountIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "grantedScopes": {
            "type": "string",
            "example": "accounts:read balances:read"
          },
          "actorUserId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["accountIds", "grantedScopes", "actorUserId"]
      },
      "ActivateConsentRequestDto": {
        "type": "object",
        "properties": {
          "actorUserId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["actorUserId"]
      },
      "RevokeConsentRequestDto": {
        "type": "object",
        "properties": {
          "actorUserId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["actorUserId"]
      },
      "OAuthTokenRequestDto": {
        "type": "object",
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": ["authorization_code", "refresh_token"]
          },
          "client_id": {
            "type": "string",
            "example": "client-id"
          },
          "client_secret": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string"
          },
          "code_verifier": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          }
        },
        "required": ["grant_type", "client_id"]
      },
      "OAuthRevokeRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "token_type_hint": {
            "type": "string",
            "enum": ["access_token", "refresh_token"]
          },
          "client_id": {
            "type": "string"
          }
        },
        "required": ["token", "client_id"]
      },
      "OAuthIntrospectRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          }
        },
        "required": ["token", "client_id"]
      }
    }
  }
}
