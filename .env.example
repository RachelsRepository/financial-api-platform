NODE_ENV=development
APP_NAME=financial-api-platform
APP_PORT=3000
LOG_LEVEL=info
TRUSTED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://fap:fap_dev_secret@localhost:5432/financial_api?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=financial-api-platform
KAFKA_OUTBOX_TOPIC=financial.events
KAFKA_DLQ_TOPIC=financial.events.dlq
KAFKA_ENABLED=true

# Identity
TOKEN_ISSUER=https://localhost:3000
TOKEN_AUDIENCE=financial-api
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=86400
AUTHORIZATION_CODE_TTL_SECONDS=60
CLOCK_SKEW_SECONDS=30

# Signing keys (development only — never use in production)
# Generate with: node scripts/generate-dev-keys.mjs
JWT_ACTIVE_KID=dev-key-1
JWT_PRIVATE_JWK={"kty":"EC","crv":"P-256","d":"PLACEHOLDER_REPLACE_WITH_SCRIPT_OUTPUT","x":"PLACEHOLDER","y":"PLACEHOLDER","kid":"dev-key-1","alg":"ES256","use":"sig"}
JWT_PUBLIC_JWKS={"keys":[]}

# Security
ENABLE_SWAGGER=true
ENABLE_AUDIT=true
ENABLE_PROVIDER_SANDBOX=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
MTLS_REQUIRED=false

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
