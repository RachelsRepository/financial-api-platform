{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "prisma/**/*.ts",
    "vitest.config.ts",
    "vitest.*.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules", "dist", "coverage", "prisma/migrations"]
}
