{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "skipLibCheck": false,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts", "scripts"]
}
